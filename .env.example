# Shared by hub, worker and MCP server. Long random string: openssl rand -hex 32
RELAY_TOKEN=

# ---- hub (any machine both sides can reach; usually the one running Claude Code) ----
# Bind to your Tailscale IP, never 0.0.0.0 on an open network.
HUB_HOST=100.x.y.z
HUB_PORT=7717
HUB_DB=relay.sqlite

# ---- MCP server in the background (bun run mcp:start) ----
# MCP_PORT=7718
# MCP_HOST=127.0.0.1

# ---- worker and MCP server ----
HUB_URL=http://100.x.y.z:7717
# Worker the MCP server sends tasks to by default (hub uses it too).
RELAY_TARGET=win

# ---- worker only ----
WORKER_NAME=win
# Folder for agent tasks sent without a project (named projects live in worker/projects.json).
# Must be outside the relay checkout; without it, project-less agent tasks fail.
# WORKER_CWD=C:\work
# Defaults to worker/scripts.json
# WORKER_SCRIPTS=C:\claude-operator\worker\scripts.json
# Defaults to worker/projects.json (folders agent tasks may be started in, by name)
# WORKER_PROJECTS=C:\claude-operator\worker\projects.json
WORKER_MODEL=claude-haiku-5-5
# ask | edits | auto
WORKER_PERMISSION=edits
# Claude settings files agent sessions load (user, project, local). Their allow rules and hooks apply before the
# relay's permission check. Leave empty to load none.
WORKER_SETTINGS=user,project,local
# Highest level a driver may request (ask | edits | auto); higher requests are lowered to this
WORKER_MAX_PERMISSION=auto
WORKER_MAX_CONCURRENT=2
WORKER_PERMISSION_TIMEOUT_MIN=30
# 1 = keep ANTHROPIC_API_KEY and bill the API instead of your Claude login
WORKER_USE_API_KEY=0
